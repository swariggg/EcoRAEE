os&#xa;de la cuenta" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="1"><mxGeometry x="1315" y="960" width="48" height="48" as="geometry"/></mxCell><mxCell id="n46" value="Certificate Manager&#xa;certificado TLS&#xa;para el ALB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;" vertex="1" parent="1"><mxGeometry x="1500" y="960" width="48" height="48" as="geometry"/></mxCell><mxCell id="n47" value="1 · HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n6" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="260"/><mxPoint x="400" y="190"/><mxPoint x="863" y="190"/></Array></mxGeometry></mxCell><mxCell id="n49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="863" y="345"/><mxPoint x="588" y="345"/></Array></mxGeometry></mxCell><mxCell id="n50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="863" y="345"/><mxPoint x="1108" y="345"/></Array></mxGeometry></mxCell><mxCell id="n51" value="2 · SQL 1433" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n25" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n26" target="n33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1108" y="622"/><mxPoint x="590" y="622"/></Array></mxGeometry></mxCell><mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#8C4FFF;" edge="1" parent="1" source="n25" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="492" y="488"/></Array></mxGeometry></mxCell><mxCell id="n54" value="3 · salida a internet" style="text;html=1;fontSize=10;align=left;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="498" y="335" width="150" height="20" as="geometry"/></mxCell><mxCell id="n55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#8C4FFF;" edge="1" parent="1" source="n14" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="252"/><mxPoint x="430" y="270"/></Array></mxGeometry></mxCell><mxCell id="n56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#8C4FFF;" edge="1" parent="1" source="n26" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1212" y="488"/></Array></mxGeometry></mxCell><mxCell id="n57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#8C4FFF;" edge="1" parent="1" source="n19" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1212" y="115"/><mxPoint x="330" y="115"/></Array></mxGeometry></mxCell><mxCell id="n58" value="4 · evidencias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n26" target="n36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="488"/></Array></mxGeometry></mxCell><mxCell id="n59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n36" target="n38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n60" value="4b · el navegador sube la foto con URL prefirmada (5 min)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n3" target="n38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="30"/><mxPoint x="1590" y="30"/></Array></mxGeometry></mxCell><mxCell id="n61" value="5 · secretos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#DD344C;fontColor=#DD344C;" edge="1" parent="1" source="n25" target="n41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="488"/><mxPoint x="350" y="905"/><mxPoint x="599" y="905"/></Array></mxGeometry></mxCell><mxCell id="n62" value="6 · logs y métricas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#E7157B;fontColor=#E7157B;" edge="1" parent="1" source="n25" target="n44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="488"/><mxPoint x="870" y="905"/><mxPoint x="1154" y="905"/></Array></mxGeometry></mxCell><mxCell id="n63" value="&lt;b&gt;Cómo funciona&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; El usuario entra por internet al &lt;b&gt;Internet Gateway&lt;/b&gt; y llega al &lt;b&gt;Load Balancer&lt;/b&gt; (subredes públicas de las 2 zonas). El ALB reparte las peticiones entre las EC2 del Auto Scaling Group, que están en subredes privadas. Cada EC2 entrega la página web y la API.&lt;br&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt; La API habla con &lt;b&gt;RDS for SQL Server Express&lt;/b&gt; por el puerto 1433. Ahí viven los triggers y procedimientos del segundo avance.&lt;br&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Las EC2 privadas no tienen IP pública. Para salir a internet (actualizaciones, librerías) cada zona usa &lt;b&gt;su propio NAT Gateway&lt;/b&gt;, que sale por el Internet Gateway. Si se cae una zona, la otra sigue saliendo. Desde internet nadie puede entrar a las EC2.&lt;br&gt;&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Evidencias: la API firma una URL temporal y el navegador sube la foto al bucket privado (4b). La API lee el bucket por el VPC Endpoint, sin pasar por el NAT. El bucket se cifra con una llave KMS propia.&lt;br&gt;&lt;br&gt;&lt;b&gt;5&lt;/b&gt; La contraseña de RDS y la clave JWT están en &lt;b&gt;Secrets Manager&lt;/b&gt;, no en el código.&lt;br&gt;&lt;br&gt;&lt;b&gt;6&lt;/b&gt; CloudWatch mide la CPU. Normalmente hay 2 EC2 (una por zona). Si el promedio pasa de 60 %, el Auto Scaling agrega más, hasta 4; si baja, vuelve a 2.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sin SNS:&lt;/b&gt; las alarmas se revisan en la consola de CloudWatch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1740" y="60" width="380" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>