<mxfile host="app.diagrams.net"><diagram id="p1" name="Inicio de sesión"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Proceso de inicio de sesión (login con JWT) · EcoRAEE Cloud" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1350" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Usuario · navegador (SPA)" style="swimlane;html=1;startSize=34;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;swimlaneFillColor=#FAFAFA;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="270" height="1250" as="geometry"/></mxCell><mxCell id="n4" value="Internet Gateway → ALB (HTTPS)" style="swimlane;html=1;startSize=34;fillColor=#8C4FFF;fontColor=#FFFFFF;strokeColor=#8C4FFF;swimlaneFillColor=#FAFAFA;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="270" height="1250" as="geometry"/></mxCell><mxCell id="n5" value="API FastAPI en EC2" style="swimlane;html=1;startSize=34;fillColor=#ED7100;fontColor=#FFFFFF;strokeColor=#ED7100;swimlaneFillColor=#FAFAFA;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="270" height="1250" as="geometry"/></mxCell><mxCell id="n6" value="Secrets Manager" style="swimlane;html=1;startSize=34;fillColor=#DD344C;fontColor=#FFFFFF;strokeColor=#DD344C;swimlaneFillColor=#FAFAFA;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="830" y="60" width="270" height="1250" as="geometry"/></mxCell><mxCell id="n7" value="RDS SQL Server · ECORAEE" style="swimlane;html=1;startSize=34;fillColor=#C925D1;fontColor=#FFFFFF;strokeColor=#C925D1;swimlaneFillColor=#FAFAFA;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="270" height="1250" as="geometry"/></mxCell><mxCell id="n8" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="95.0" y="110" width="120" height="40" as="geometry"/></mxCell><mxCell id="n9" value="1. El usuario abre la web y escribe su correo institucional y contraseña" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="50.0" y="180" width="210" height="60" as="geometry"/></mxCell><mxCell id="n10" value="2. POST /api/auth/login viaja cifrado (TLS) y entra por el Internet Gateway al Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="320.0" y="180" width="210" height="60" as="geometry"/></mxCell><mxCell id="n11" value="3. Una EC2 sana recibe la petición. Valida formato del correo y límite de intentos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="590.0" y="180" width="210" height="60" as="geometry"/></mxCell><mxCell id="n12" value="4. Entrega la clave para firmar JWT (la API la guarda en memoria al arrancar)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="865.0" y="180" width="200" height="60" as="geometry"/></mxCell><mxCell id="n13" value="5. Busca al usuario con consulta parametrizada (sin concatenar texto: evita inyección SQL)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="590.0" y="290" width="210" height="60" as="geometry"/></mxCell><mxCell id="n14" value="SELECT u.id_usuario, u.hash_password, u.activo, r.nombre_rol&#xa;FROM usuario u JOIN rol r ...&#xa;WHERE u.correo_institucional = ?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1120.0" y="290" width="230" height="70" as="geometry"/></mxCell><mxCell id="n15" value="¿Existe y está activo?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#232F3E;fillColor=#FFF4E5;" vertex="1" parent="1"><mxGeometry x="605.0" y="400" width="180" height="100" as="geometry"/></mxCell><mxCell id="n16" value="¿bcrypt.verify(contraseña, hash_password)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#232F3E;fillColor=#FFF4E5;" vertex="1" parent="1"><mxGeometry x="605.0" y="540" width="180" height="100" as="geometry"/></mxCell><mxCell id="n17" value="401 &quot;Credenciales inválidas&quot; (mismo mensaje en ambos casos: no revela si el correo existe)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#B71C1C;fillColor=#FFEBEE;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="320.0" y="470" width="210" height="70" as="geometry"/></mxCell><mxCell id="n18" value="INSERT INTO auditoria&#xa;(usuario, LOGIN_FALLIDO, ...)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1130.0" y="470" width="210" height="60" as="geometry"/></mxCell><mxCell id="n19" value="6. Genera el token JWT: sub = id_usuario, rol, exp = 30 min. Firmado con la clave del paso 4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#1B5E20;fillColor=#E8F5E9;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="590.0" y="690" width="210" height="60" as="geometry"/></mxCell><mxCell id="n20" value="INSERT INTO auditoria&#xa;(usuario, LOGIN, ...)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1130.0" y="690" width="210" height="60" as="geometry"/></mxCell><mxCell id="n21" value="7. Recibe 200 {access_token}. Lo guarda en memoria (no en localStorage)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#1B5E20;fillColor=#E8F5E9;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="50.0" y="690" width="210" height="60" as="geometry"/></mxCell><mxCell id="n22" value="8. En cada petición envía&#xa;Authorization: Bearer &amp;lt;token&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="50.0" y="810" width="210" height="60" as="geometry"/></mxCell><mxCell id="n23" value="9. Verifica firma y vencimiento del token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="590.0" y="810" width="210" height="60" as="geometry"/></mxCell><mxCell id="n24" value="¿El rol puede usar este endpoint?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#232F3E;fillColor=#FFF4E5;" vertex="1" parent="1"><mxGeometry x="605.0" y="920" width="180" height="100" as="geometry"/></mxCell><mxCell id="n25" value="401 si el token es inválido o venció · 403 si el rol no tiene permiso" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#B71C1C;fillColor=#FFEBEE;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="320.0" y="945" width="210" height="50" as="geometry"/></mxCell><mxCell id="n26" value="10. Ejecuta el procedimiento. Pasa id_usuario con SESSION_CONTEXT para la auditoría" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#1B5E20;fillColor=#E8F5E9;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="590.0" y="1070" width="210" height="60" as="geometry"/></mxCell><mxCell id="n27" value="EXEC sp_... (los triggers registran historial y auditoría)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1130.0" y="1070" width="210" height="60" as="geometry"/></mxCell><mxCell id="n28" value="Fin" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="95.0" y="1190" width="120" height="40" as="geometry"/></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#DD344C;" edge="1" parent="1" source="n12" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="fila o vacío" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="450"/></Array></mxGeometry></mxCell><mxCell id="n36" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="450"/></Array></mxGeometry></mxCell><mxCell id="n38" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="590"/></Array></mxGeometry></mxCell><mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="640"/><mxPoint x="1135" y="640"/></Array></mxGeometry></mxCell><mxCell id="n40" value="reintentar (máx. 5 por minuto)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n17" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="505"/><mxPoint x="320" y="240"/><mxPoint x="155" y="240"/></Array></mxGeometry></mxCell><mxCell id="n41" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n21" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n46" value="válido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n47" value="inválido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="642" y="885"/><mxPoint x="425" y="885"/></Array></mxGeometry></mxCell><mxCell id="n48" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n49" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n24" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n51" value="resultado (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="1210"/></Array></mxGeometry></mxCell><mxCell id="n52" value="&lt;b&gt;Por qué así&lt;/b&gt;&lt;br&gt;• La contraseña nunca se guarda en texto plano: la tabla usuario solo tiene hash_password (bcrypt).&lt;br&gt;• La clave JWT y la contraseña de RDS viven en Secrets Manager, no en el código.&lt;br&gt;• El rol del token decide qué puede hacer cada usuario (RF de seguridad): p. ej. solo TEC evalúa, solo COO asigna destinos.&lt;br&gt;• Todo login (exitoso o fallido) queda en auditoria." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1330" width="1350" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>