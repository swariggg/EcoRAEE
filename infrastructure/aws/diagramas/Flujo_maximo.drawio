<mxfile host="app.diagrams.net"><diagram id="p1" name="Flujo máximo ESC-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Red de flujo máximo · Escenario ESC-1 (capacidades en kg por semana)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Cada flecha muestra  flujo / capacidad. Resultado de Edmonds-Karp: flujo máximo = 140 kg/semana. En rojo, el corte mínimo." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="26" as="geometry"/></mxCell><mxCell id="n4" value="S" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="44" y="334" width="92" height="92" as="geometry"/></mxCell><mxCell id="n5" value="Fuente&#xa;(generación del campus)" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="428" width="140" height="44" as="geometry"/></mxCell><mxCell id="n6" value="NOR" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="314" y="154" width="92" height="92" as="geometry"/></mxCell><mxCell id="n7" value="Acopio&#xa;Campus Norte" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="290" y="248" width="140" height="44" as="geometry"/></mxCell><mxCell id="n8" value="SUR" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="314" y="514" width="92" height="92" as="geometry"/></mxCell><mxCell id="n9" value="Acopio&#xa;Campus Sur" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="290" y="608" width="140" height="44" as="geometry"/></mxCell><mxCell id="n10" value="LAB" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="594" y="334" width="92" height="92" as="geometry"/></mxCell><mxCell id="n11" value="Laboratorio de&#xa;Evaluación" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="570" y="428" width="140" height="44" as="geometry"/></mxCell><mxCell id="n12" value="TAL" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="874" y="84" width="92" height="92" as="geometry"/></mxCell><mxCell id="n13" value="Taller&#xa;Reacondiciona" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="178" width="140" height="44" as="geometry"/></mxCell><mxCell id="n14" value="REC" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="874" y="374" width="92" height="92" as="geometry"/></mxCell><mxCell id="n15" value="EcoGestor&#xa;Reciclaje" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="468" width="140" height="44" as="geometry"/></mxCell><mxCell id="n16" value="DIS" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=#D32F2F;strokeWidth=4;dashed=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="874" y="604" width="92" height="92" as="geometry"/></mxCell><mxCell id="n17" value="Disposición&#xa;final" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="698" width="140" height="44" as="geometry"/></mxCell><mxCell id="n18" value="FUN" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1134" y="84" width="92" height="92" as="geometry"/></mxCell><mxCell id="n19" value="Fundación&#xa;Conecta" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="178" width="140" height="44" as="geometry"/></mxCell><mxCell id="n20" value="T" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#D32F2F;strokeWidth=4;dashed=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1374" y="334" width="92" height="92" as="geometry"/></mxCell><mxCell id="n21" value="Sumidero&#xa;(destino circular)" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1350" y="428" width="140" height="44" as="geometry"/></mxCell><mxCell id="n22" value="70 / 120" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#78909C;strokeWidth=1.5;fontColor=#455A64;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="70 / 80" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#78909C;strokeWidth=1.5;fontColor=#455A64;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="30 / 70" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#78909C;strokeWidth=1.5;fontColor=#455A64;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="50 / 50" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#232F3E;strokeWidth=3;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="40 / 40" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#232F3E;strokeWidth=3;" edge="1" parent="1" source="n6" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="20 / 20" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#232F3E;strokeWidth=3;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="35 / 40" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#78909C;strokeWidth=1.5;fontColor=#455A64;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="30 / 30" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#232F3E;strokeWidth=3;" edge="1" parent="1" source="n10" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="15 / 15" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#D32F2F;strokeWidth=4;fontColor=#D32F2F;" edge="1" parent="1" source="n10" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="35 / 35" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#232F3E;strokeWidth=3;" edge="1" parent="1" source="n12" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="35 / 35" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#D32F2F;strokeWidth=4;fontColor=#D32F2F;" edge="1" parent="1" source="n18" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="90 / 90" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#D32F2F;strokeWidth=4;fontColor=#D32F2F;" edge="1" parent="1" source="n14" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="15 / 20" style="endArrow=block;endFill=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;rounded=0;strokeColor=#78909C;strokeWidth=1.5;fontColor=#455A64;" edge="1" parent="1" source="n16" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="Corte mínimo: LAB→DIS (15) + FUN→T (35) + REC→T (90) = 140 kg&#xa;Separa el lado S (todo lo demás) del lado T = {DIS, T} (borde rojo punteado)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#D32F2F;align=left;" vertex="1" parent="1"><mxGeometry x="1020" y="700" width="480" height="60" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Caminos aumentantes que encontró Edmonds-Karp&lt;/b&gt; (BFS, el más corto primero)&lt;br&gt;&lt;br&gt;1. S → SUR → REC → T &amp;nbsp;&lt;b&gt;+20&lt;/b&gt;&lt;br&gt;2. S → NOR → REC → T &amp;nbsp;&lt;b&gt;+40&lt;/b&gt;&lt;br&gt;3. S → SUR → LAB → REC → T &amp;nbsp;&lt;b&gt;+30&lt;/b&gt;&lt;br&gt;4. S → SUR → LAB → DIS → T &amp;nbsp;&lt;b&gt;+15&lt;/b&gt;&lt;br&gt;5. S → SUR → LAB → TAL → FUN → T &amp;nbsp;&lt;b&gt;+5&lt;/b&gt;&lt;br&gt;6. S → NOR → LAB → TAL → FUN → T &amp;nbsp;&lt;b&gt;+30&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Total = 140 kg/semana&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="520" height="210" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;• Flecha negra gruesa: arista saturada (flujo = capacidad)&lt;br&gt;• Flecha gris: queda capacidad libre&lt;br&gt;• Flecha roja: arista del corte mínimo&lt;br&gt;• Azul: centros del campus · Verde: destinos externos&lt;br&gt;• S y T son nodos artificiales (super-fuente y super-sumidero)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="800" width="460" height="210" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Qué significa para la universidad&lt;/b&gt;&lt;br&gt;Aunque los campus generan 200 kg/semana, solo 140 kg llegan a un destino. El cuello de botella &lt;u&gt;no&lt;/u&gt; son los centros de acopio sino la recepción de los destinos (reciclaje 90 kg, Fundación 35 kg) y la salida del laboratorio a disposición final (15 kg).&lt;br&gt;ESC-2 (laboratorio x2) sube solo a 145 kg; ESC-3 (más generación) sigue en 140 kg. Para crecer hay que conseguir más capacidad en los destinos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="800" width="480" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>