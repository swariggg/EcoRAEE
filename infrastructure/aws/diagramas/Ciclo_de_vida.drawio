<mxfile host="app.diagrams.net"><diagram id="p1" name="Ciclos de vida"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Ciclo de vida del dispositivo (dispositivo.estado_actual) · EcoRAEE Cloud" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Cada flecha es la única forma permitida de cambiar de estado. Un cambio distinto lo rechaza el trigger tr_dispositivo_cambio_estado, y cada cambio válido se guarda en historial y auditoria." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="45" width="1500" height="30" as="geometry"/></mxCell><mxCell id="n4" value="" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="24" height="24" as="geometry"/></mxCell><mxCell id="n5" value="Registrado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="120" y="302" width="160" height="56" as="geometry"/></mxCell><mxCell id="n6" value="Recolectado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="400" y="302" width="160" height="56" as="geometry"/></mxCell><mxCell id="n7" value="Evaluado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="680" y="302" width="160" height="56" as="geometry"/></mxCell><mxCell id="n8" value="Reacondicionamiento" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="190" height="56" as="geometry"/></mxCell><mxCell id="n9" value="Reciclaje" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1080" y="302" width="190" height="56" as="geometry"/></mxCell><mxCell id="n10" value="Disposicion" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="1080" y="480" width="190" height="56" as="geometry"/></mxCell><mxCell id="n11" value="Asignado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="1450" y="130" width="160" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Valorizado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="1450" y="302" width="160" height="56" as="geometry"/></mxCell><mxCell id="n13" value="Cerrado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#ECEFF1;strokeColor=#37474F;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1760" y="302" width="160" height="56" as="geometry"/></mxCell><mxCell id="n14" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#232F3E;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1980" y="316" width="28" height="28" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="sp_recibir_solicitud&#xa;(el operador recibe&#xa;en el centro)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="sp_registrar_evaluacion&#xa;(el técnico asigna 1 de&#xa;las 4 clasificaciones)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="re-evaluación&#xa;(sigue en Evaluado)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;dashed=1;" edge="1" parent="1" source="n7" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="250"/><mxPoint x="750" y="250"/></Array></mxGeometry></mxCell><mxCell id="n19" value="sp_asignar_destino → Reacondicionador&#xa;[Reutilizable o Reparable]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;exitX=0.85;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="816" y="158"/></Array></mxGeometry></mxCell><mxCell id="n20" value="sp_asignar_destino →&#xa;Gestor de reciclaje&#xa;[Reciclable]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="sp_asignar_destino → Disposición final&#xa;[No recuperable]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;exitX=0.85;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="816" y="508"/></Array></mxGeometry></mxCell><mxCell id="n22" value="sp_registrar_tratamiento +&#xa;sp_asignar_destino → Beneficiario" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="sp_registrar_tratamiento&#xa;(tipo Reciclaje)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="158"/><mxPoint x="1690" y="320"/></Array></mxGeometry></mxCell><mxCell id="n25" value="sp_cerrar_trazabilidad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="508"/><mxPoint x="1690" y="340"/></Array></mxGeometry></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="RN-08: solo se cierra si el estado es final (Asignado, Valorizado o Disposicion) y la última transferencia está confirmada con evidencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1715" y="380" width="230" height="75" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Clasificación → destino permitido&lt;/b&gt; (tabla compatibilidad_destino)&lt;br&gt;• Reutilizable → Reacondicionador o Beneficiario&lt;br&gt;• Reparable → Reacondicionador o Beneficiario&lt;br&gt;• Reciclable → Gestor de reciclaje&lt;br&gt;• No recuperable → Disposición final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="120" y="400" width="520" height="110" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Moverse entre centros&lt;/b&gt; (sp_mover_dispositivo / sp_cerrar_movimiento) &lt;u&gt;no&lt;/u&gt; cambia el estado: el equipo sigue en el mismo estado, solo cambia id_centro_actual." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="120" y="525" width="520" height="55" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Colores&lt;/b&gt;: azul = en el campus · amarillo = en tratamiento · verde = destino final · gris = trazabilidad cerrada" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="800" height="30" as="geometry"/></mxCell><mxCell id="n32" value="" style="line;strokeColor=#BDBDBD;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="2020" height="2" as="geometry"/></mxCell><mxCell id="n33" value="Ciclos de vida de las operaciones" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="655" width="1500" height="30" as="geometry"/></mxCell><mxCell id="n34" value="Solicitud (estado_solicitud)" style="swimlane;html=1;startSize=30;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="695" width="580" height="260" as="geometry"/></mxCell><mxCell id="n35" value="" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="35" y="765" width="20" height="20" as="geometry"/></mxCell><mxCell id="n36" value="Pendiente" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="747" width="170" height="56" as="geometry"/></mxCell><mxCell id="n37" value="Recibida" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#ECEFF1;strokeColor=#37474F;fontColor=#263238;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="747" width="160" height="56" as="geometry"/></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n35" target="n36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="sp_recibir_solicitud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n36" target="n37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n40" value="Cancelada" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="830" width="160" height="56" as="geometry"/></mxCell><mxCell id="n41" value="el generador cancela" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n36" target="n40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="858"/></Array></mxGeometry></mxCell><mxCell id="n42" value="La crea el generador (docente, administrativo o estudiante). Al recibirla, todos sus dispositivos pasan a Recolectado." style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="35" y="895" width="550" height="55" as="geometry"/></mxCell><mxCell id="n43" value="Movimiento entre centros (estado_movimiento)" style="swimlane;html=1;startSize=30;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="660" y="695" width="580" height="260" as="geometry"/></mxCell><mxCell id="n44" value="" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="675" y="765" width="20" height="20" as="geometry"/></mxCell><mxCell id="n45" value="Abierto" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="747" width="170" height="56" as="geometry"/></mxCell><mxCell id="n46" value="Cerrado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#ECEFF1;strokeColor=#37474F;fontColor=#263238;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="747" width="160" height="56" as="geometry"/></mxCell><mxCell id="n47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n44" target="n45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n48" value="sp_cerrar_movimiento" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n45" target="n46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n49" value="Lo abre sp_mover_dispositivo. RN-03: no se cierra sin origen, destino, responsable y evidencia (foto en S3)." style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="675" y="895" width="550" height="55" as="geometry"/></mxCell><mxCell id="n50" value="Transferencia a destino (estado_cierre)" style="swimlane;html=1;startSize=30;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1300" y="695" width="580" height="260" as="geometry"/></mxCell><mxCell id="n51" value="" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1315" y="765" width="20" height="20" as="geometry"/></mxCell><mxCell id="n52" value="Pendiente_Evidencia" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="747" width="170" height="56" as="geometry"/></mxCell><mxCell id="n53" value="Cerrado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;fillColor=#ECEFF1;strokeColor=#37474F;fontColor=#263238;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="747" width="160" height="56" as="geometry"/></mxCell><mxCell id="n54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n51" target="n52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n55" value="sp_confirmar_transferencia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="n52" target="n53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n56" value="La abre sp_asignar_destino. Solo puede haber una abierta por dispositivo. Se confirma cuando el destino sube la evidencia." style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1315" y="895" width="550" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>