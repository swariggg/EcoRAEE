<mxfile host="app.diagrams.net"><diagram id="p1" name="Políticas IAM de la EC2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Rol IAM de las EC2 de la API (ecoraee-ec2-api-role) · mínimo privilegio" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="36" as="geometry"/></mxCell><mxCell id="n3" value="La EC2 no guarda access keys: obtiene credenciales temporales del rol a través del instance profile. Cada caja dice qué puede hacer y sobre qué recurso exactamente." style="text;html=1;fontSize=12;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="26" as="geometry"/></mxCell><mxCell id="n4" value="Auto Scaling Group" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_auto_scaling_group;strokeColor=#ED7100;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#ED7100;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="230" height="420" as="geometry"/></mxCell><mxCell id="n5" value="EC2 · API FastAPI" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="105" y="190" width="56" height="56" as="geometry"/></mxCell><mxCell id="n6" value="EC2 · API FastAPI&#xa;(réplica)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="105" y="330" width="56" height="56" as="geometry"/></mxCell><mxCell id="n7" value="Todas las EC2 nuevas que crea el Auto Scaling usan la misma launch template, así que reciben el mismo rol automáticamente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="35" y="440" width="200" height="90" as="geometry"/></mxCell><mxCell id="n8" value="ecoraee-ec2-api-role&#xa;+ instance profile" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="1"><mxGeometry x="330" y="275" width="64" height="64" as="geometry"/></mxCell><mxCell id="n9" value="asume el rol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="218"/></Array></mxGeometry></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="358"/></Array></mxGeometry></mxCell><mxCell id="n11" value="&lt;b&gt;Trust policy&lt;/b&gt;&lt;br&gt;Solo ec2.amazonaws.com puede asumirlo (sts:AssumeRole).&lt;br&gt;&lt;i&gt;01_..._TRUST.json&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="290" y="400" width="160" height="90" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;AmazonSSMManagedInstanceCore&lt;/b&gt; (de AWS)&lt;br&gt;Deja que Systems Manager administre la EC2: entrar con Session Manager &lt;u&gt;sin SSH ni puerto 22&lt;/u&gt; y aplicar parches." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#F3F3F3;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="420" height="100" as="geometry"/></mxCell><mxCell id="n13" value="" style="endArrow=none;html=1;strokeColor=#DD344C;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="307"/><mxPoint x="475" y="140.0"/></Array></mxGeometry></mxCell><mxCell id="n14" value="&lt;b&gt;CloudWatchAgentServerPolicy&lt;/b&gt; (de AWS)&lt;br&gt;Deja que el agente envíe logs de la API y métricas (CPU, memoria, disco) a CloudWatch. Con esas métricas escala el Auto Scaling." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#F3F3F3;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="420" height="100" as="geometry"/></mxCell><mxCell id="n15" value="" style="endArrow=none;html=1;strokeColor=#DD344C;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="307"/><mxPoint x="475" y="280.0"/></Array></mxGeometry></mxCell><mxCell id="n16" value="&lt;b&gt;EcoRAEE-API-Evidence-RW&lt;/b&gt; (propia)&lt;br&gt;✔ s3:GetObject y s3:PutObject solo en ecoraee-evidencias/&lt;b&gt;evidencias/*&lt;/b&gt; (también firma las URL prefirmadas)&lt;br&gt;✔ s3:ListBucket solo con prefijo evidencias/&lt;br&gt;✔ KMS solo a través de S3&lt;br&gt;&lt;font color=&quot;#B71C1C&quot;&gt;✘ Deny DeleteObject: la evidencia es prueba legal, nunca se borra&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#FFF5F5;strokeColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="520" y="370" width="420" height="120" as="geometry"/></mxCell><mxCell id="n17" value="" style="endArrow=none;html=1;strokeColor=#DD344C;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n8" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="307"/><mxPoint x="475" y="430.0"/></Array></mxGeometry></mxCell><mxCell id="n18" value="&lt;b&gt;EcoRAEE-API-SecretRead&lt;/b&gt; (propia)&lt;br&gt;✔ secretsmanager:GetSecretValue solo en &lt;b&gt;ecoraee/rds/*&lt;/b&gt; (usuario y contraseña de SQL Server) y &lt;b&gt;ecoraee/jwt/*&lt;/b&gt; (clave de los tokens)&lt;br&gt;✔ kms:Decrypt solo a través de Secrets Manager" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#FFF5F5;strokeColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="520" y="550" width="420" height="110" as="geometry"/></mxCell><mxCell id="n19" value="" style="endArrow=none;html=1;strokeColor=#DD344C;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n8" target="n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="307"/><mxPoint x="475" y="605.0"/></Array></mxGeometry></mxCell><mxCell id="n20" value="Systems Manager" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="1040" y="95" width="56" height="56" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="CloudWatch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1040" y="235" width="56" height="56" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n14" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="S3 ecoraee-evidencias&#xa;(privado, KMS)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1040" y="395" width="56" height="56" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="Secrets Manager" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1040" y="570" width="56" height="56" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="&lt;b&gt;Qué se corrigió respecto al Avance 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. En el Avance 1, Evidence-RW y SecretRead solo tenían nombre. Ahora cada una dice qué acciones permite y sobre qué recurso (archivos JSON en la carpeta iam).&lt;br&gt;&lt;br&gt;2. Evidence-RW se limita a la carpeta &lt;b&gt;evidencias/&lt;/b&gt; (dev/ es del grupo Developers) y prohíbe borrar. SecretRead incluye también la clave &lt;b&gt;JWT&lt;/b&gt; del login.&lt;br&gt;&lt;br&gt;3. Se agregaron los permisos de &lt;b&gt;KMS&lt;/b&gt;: sin ellos la API no puede leer un objeto cifrado ni un secreto, aunque tenga s3:GetObject.&lt;br&gt;&lt;br&gt;4. La condición &lt;b&gt;kms:ViaService&lt;/b&gt; impide usar la llave para otra cosa.&lt;br&gt;&lt;br&gt;5. Se quitó CloudFormation: el rol de despliegue y su política ya no existen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1170" y="90" width="330" height="300" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Lo que la EC2 &lt;u&gt;no&lt;/u&gt; puede hacer&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Borrar evidencias ni leer otras carpetas del bucket.&lt;br&gt;• Leer secretos de otros proyectos.&lt;br&gt;• Crear usuarios, roles o llaves.&lt;br&gt;• Conectarse a RDS por IAM: a SQL Server entra con usuario y contraseña que saca de Secrets Manager; el acceso de red lo controla el security group (1433 solo desde SG-API)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1170" y="410" width="330" height="270" as="geometry"/></mxCell><mxCell id="n30" value="Otras políticas corregidas (grupos del equipo)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1480" height="30" as="geometry"/></mxCell><mxCell id="n31" value="Política" style="whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="230" height="32" as="geometry"/></mxCell><mxCell id="n32" value="Antes (Avance 1)" style="whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="250" y="760" width="330" height="32" as="geometry"/></mxCell><mxCell id="n33" value="Ahora" style="whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="580" y="760" width="470" height="32" as="geometry"/></mxCell><mxCell id="n34" value="Por qué" style="whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1050" y="760" width="450" height="32" as="geometry"/></mxCell><mxCell id="n35" value="EcoRAEE-App-Operate" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="792" width="230" height="58" as="geometry"/></mxCell><mxCell id="n36" value="ec2:Start/Stop/Reboot en la EC2 con tag Role=api" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="250" y="792" width="330" height="58" as="geometry"/></mxCell><mxCell id="n37" value="autoscaling:SetDesiredCapacity y StartInstanceRefresh en el ASG del proyecto + Reboot + Session Manager" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="580" y="792" width="470" height="58" as="geometry"/></mxCell><mxCell id="n38" value="Con Auto Scaling, si alguien detiene una EC2 el ASG la ve &quot;no sana&quot;, la termina y crea otra. Para apagar se pone deseado = 0." style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1050" y="792" width="450" height="58" as="geometry"/></mxCell><mxCell id="n39" value="EcoRAEE-PassRole-Restricted" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FAFAFA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="230" height="58" as="geometry"/></mxCell><mxCell id="n40" value="iam:PassRole sobre los roles del proyecto" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="250" y="850" width="330" height="58" as="geometry"/></mxCell><mxCell id="n41" value="Igual, pero con iam:PassedToService: el rol de la API solo se pasa a EC2 y el de monitoreo solo a RDS" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="580" y="850" width="470" height="58" as="geometry"/></mxCell><mxCell id="n42" value="Evita que alguien pase el rol de la EC2 a otro servicio (por ejemplo a una Lambda) para usar sus permisos." style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="1050" y="850" width="450" height="58" as="geometry"/></mxCell><mxCell id="n43" value="EcoRAEE-ForceMFA" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="908" width="230" height="58" as="geometry"/></mxCell><mxCell id="n44" value="Deny a todo si aws:MultiFactorAuthPresent = false" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="250" y="908" width="330" height="58" as="geometry"/></mxCell><mxCell id="n45" value="Deny con NotAction: deja configurar el MFA y cambiar la contraseña sin MFA" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="580" y="908" width="470" height="58" as="geometry"/></mxCell><mxCell id="n46" value="Sin la excepción, un usuario nuevo no puede ni registrar su MFA y queda bloqueado." style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;strokeColor=#BDBDBD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1050" y="908" width="450" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>