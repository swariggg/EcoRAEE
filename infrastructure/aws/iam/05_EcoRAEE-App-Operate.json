{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerEstadoDelAutoScalingYLasEC2",
      "Effect": "Allow",
      "Action": [
        "autoscaling:Describe*",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ssm:DescribeInstanceInformation",
        "ssm:GetConnectionStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CambiarCuantasEC2HayYRenovarlas",
      "Effect": "Allow",
      "Action": [
        "autoscaling:SetDesiredCapacity",
        "autoscaling:StartInstanceRefresh",
        "autoscaling:CancelInstanceRefresh"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "autoscaling:ResourceTag/Project": "EcoRAEE"
        }
      }
    },
    {
      "Sid": "ReiniciarSoloEC2DeLaAPI",
      "Effect": "Allow",
      "Action": "ec2:RebootInstances",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Role": "api",
          "aws:ResourceTag/Project": "EcoRAEE"
        }
      }
    },
    {
      "Sid": "EntrarPorSessionManagerSoloALaAPI",
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession",
        "ssm:SendCommand"
      ],
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Role": "api"
        }
      }
    },
    {
      "Sid": "DocumentosPermitidos",
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession",
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1::document/AWS-StartPortForwardingSessionToRemoteHost",
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript",
        "arn:aws:ssm:us-east-1:ACCOUNT_ID:document/SSM-SessionManagerRunShell"
      ]
    },
    {
      "Sid": "CerrarSoloSusPropiasSesiones",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:*:*:session/${aws:username}-*"
    }
  ]
}
