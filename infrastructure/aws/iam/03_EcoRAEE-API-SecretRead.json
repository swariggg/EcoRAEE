{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerSoloLosSecretosDeLaApp",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ecoraee/rds/*",
        "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ecoraee/jwt/*"
      ]
    },
    {
      "Sid": "DescifrarSoloAtravesDeSecretsManager",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:ACCOUNT_ID:key/KMS_KEY_ID",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com"
        }
      }
    }
  ]
}