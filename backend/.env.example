# Copie este archivo como .env y ajuste los valores. El archivo .env NO se sube a Git.

# --- SQL Server local ---
DB_SERVER=localhost
DB_NAME=EcoRaEE_CLOUD
# yes = autenticación de Windows (no necesita usuario ni contraseña)
DB_TRUSTED=yes
# Solo si DB_TRUSTED=no (autenticación de SQL Server):
DB_USER=
DB_PASSWORD=
# Vacío = se detecta solo (ODBC Driver 18, 17 o "SQL Server")
DB_DRIVER=

# --- Seguridad ---
# Clave para firmar los tokens JWT. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_MINUTOS=120
